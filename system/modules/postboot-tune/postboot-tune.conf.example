# postboot-tune configuration.
# Copy to /data/adb/postboot-tune.conf, or put the real values in the
# gitignored config/postboot-tune.conf and let ./install.sh push it.
#
# Two independent one-shot actions, both after boot_completed + WAIT_BOOT:
#   STOP_PKGS    force-stop; non-persistent apps stay dead
#   FREEZE_PROCS SIGSTOP; CPU stops but memory stays (SIGCONT to undo)

# Seconds to let the system settle after boot_completed.
WAIT_BOOT=40

# Before freezing, wait for STATIC_IP on IFACE (max WAIT_STATIC seconds).
# FREEZE_NEEDS_NET procs are skipped while it is absent.
IFACE=wlan0
STATIC_IP=192.168.31.213
WAIT_STATIC=150

# force-stop: on-demand apps that do not come back by themselves.
STOP_PKGS="com.android.settings com.android.providers.downloads com.android.packageinstaller com.android.providers.calendar"

# SIGSTOP: persistent processes that keep restarting when killed.
FREEZE_PROCS="com.mediatek.wfo.impl com.mediatek.gba com.meizu.experiencedatasync com.mediatek.atci.service com.mediatek.engineermode com.meizu.mzbasestationsafe com.meizu.wifiadmin"

# Skip these when STATIC_IP is missing, so a slow/broken WiFi does not get
# frozen before it has connected.
FREEZE_NEEDS_NET="com.meizu.wifiadmin"
