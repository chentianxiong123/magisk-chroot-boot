install-cameraincludeHEADERS: $(camerainclude_HEADERS)
	@$(NORMAL_INSTALL)
	@list='$(camerainclude_HEADERS)'; test -n "$(cameraincludedir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(cameraincludedir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(cameraincludedir)" || exit 1; \
	fi; \
	for p in $$list; do \
	  if test -f "$$p"; then d=; else d="$(srcdir)/"; fi; \
	  echo "$$d$$p"; \
	done | $(am__base_list) | \
	while read files; do \
	  echo " $(INSTALL_HEADER) $$files '$(DESTDIR)$(cameraincludedir)'"; \
	  $(INSTALL_HEADER) $$files "$(DESTDIR)$(cameraincludedir)" || exit $$?; \
	done

uninstall-cameraincludeHEADERS:
